# /etc/caddy/sites/kamerbreed.caddy
# Voorbeeld voor de PO, zonder wachtwoord; noindex houdt zoekmachines weg.
# Tot er een domein naar de VPS wijst alleen http op poort 8080 van het IP (poort 80 is van waterzacht).
# Daarna de eerste regel vervangen door `kamerbreedinterieur.nl, www.kamerbreedinterieur.nl {`
# (of een subdomein); Caddy regelt dan zelf HTTPS. Bij livegang de X-Robots-Tag weghalen.
http://85.10.151.178:8080 {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	root * /var/www/kamerbreed

	# Vite zet een hash in de bestandsnamen, dus die mogen een jaar in de cache
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	# index.html steeds opnieuw ophalen, zodat een nieuwe versie direct te zien is
	header / Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}
